{
  "name": "vibe-on-duty",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src/ server/ tests/helpers/ --no-error-on-unmatched-pattern --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:art": "node --test \"tools/art/*.test.mjs\"",
    "mp-server": "node server/index.js",
    "build:mp": "node tests/helpers/mpServer.js --build-only",
    "test:mp": "playwright test --config playwright.multiplayer.config.js --workers=1",
    "typecheck:mp": "tsc --noEmit -p tsconfig.multiplayer.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.35",
    "@colyseus/sdk": "0.18.4",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.2.1",
    "selfsigned": "5.5.0",
    "three": "^0.160.0"
  }
}
