{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/shared/**/*.js",
    "src/network/**/*.js",
    "server/**/*.js",
    "tests/helpers/**/*.js"
  ]
}
